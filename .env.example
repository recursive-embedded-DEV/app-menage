# Copier ce fichier en .env.local (ignoré par Git) et remplir les valeurs.
# Supabase → Project Settings → API Keys / Data API.
# Ces deux valeurs sont PUBLIQUES (elles finissent dans le JavaScript du site) :
# ce sont les règles RLS qui protègent les données.
# Ne JAMAIS mettre ici la clé « secret » ni « service_role ».
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Facultative : clé d'API Google Books, RESTREINTE au site (référents HTTP) et à
# l'API Books dans la console Google Cloud. Sans elle, on saute Google Books.
VITE_GOOGLE_BOOKS_KEY=
# ID client OAuth (Agenda) : console Google Cloud → Identifiants. Public, mais
# valable seulement pour les origines JavaScript autorisées. JAMAIS le secret.
VITE_GOOGLE_CLIENT_ID=
